// ════════════════════════════════════════════════════════════════════════════
// Ferris Sweep (cradio) — Colemak-DH, matching the current Kanata
// home-row-mods profile in kamilradziszewski/dotfiles.
//
// The keyboard emits Colemak-DH directly; keep macOS on US-QWERTY.
// Comments and combo positions use physical QWERTY positions.
//
// Layers: 0 BASE · 1 NUMSYM · 2 NAV · 3 APPS · 4 FKEYS · 5 FORWARD_DELETE
// Positions: 0-9 top, 10-19 home, 20-29 bottom, 30-33 thumbs (LO/LI/RI/RO).
// ════════════════════════════════════════════════════════════════════════════

#include <behaviors.dtsi>
#include <dt-bindings/zmk/behaviors.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NUMSYM 1
#define NAV 2
#define APPS 3
#define FKEYS 4
#define FORWARD_DELETE 5

#define MEH(key) LC(LA(LS(key)))
#define HYPER(key) LG(LC(LA(LS(key))))

&sl {
    release-after-ms = <3000>;
};

/ {
    behaviors {
        // Opposite-hand key releases resolve a hold; same-hand rolls stay taps.
        left_home_row_mod: left_home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        left_home_row_shift: left_home_row_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29>;
            hold-trigger-on-release;
            bindings = <&sticky_shift>, <&kp>;
        };

        right_home_row_mod: right_home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        right_home_row_shift: right_home_row_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24>;
            hold-trigger-on-release;
            bindings = <&sticky_shift>, <&kp>;
        };

        sticky_shift: sticky_shift {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
        };

        thumb_layer_tap: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        navigation_thumb_tap: navigation_thumb_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        apps_hold_tap: apps_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&sl>, <&kp>;
        };

        numsym_space_tap: numsym_space_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <0>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&none>, <&kp SPACE>;
        };

        modifier_chord: modifier_chord {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <
                &macro_press
                &macro_param_1to1 &kp MACRO_PLACEHOLDER
                &macro_param_2to1 &kp MACRO_PLACEHOLDER
                &macro_pause_for_release
                &macro_release
                &macro_param_1to1 &kp MACRO_PLACEHOLDER
                &macro_param_2to1 &kp MACRO_PLACEHOLDER
            >;
        };

        fkey_action: fkey_action {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <
                &macro_press
                &macro_param_1to1 &kp MACRO_PLACEHOLDER
                &macro_pause_for_release
                &macro_release
                &macro_param_1to1 &kp MACRO_PLACEHOLDER
                &macro_tap &to BASE
            >;
        };

        fkeys_modifier: fkeys_modifier {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <
                &macro_press
                &macro_param_1to1 &kp MACRO_PLACEHOLDER
                &macro_tap &sl FKEYS
                &macro_pause_for_release
                &macro_release
                &macro_param_1to1 &kp MACRO_PLACEHOLDER
            >;
        };

        fkeys_rearm: fkeys_rearm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &sl FKEYS
                &macro_pause_for_release
                &macro_tap &sl FKEYS
            >;
        };

        // Shifted punctuation forks from the Kanata profile.
        mm_comma: mm_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_dot: mm_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_lpar: mm_lpar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_rpar: mm_rpar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_semicolon_colon: mm_semicolon_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_plus_equals: mm_plus_equals {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_minus_underscore: mm_minus_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_escape {
            timeout-ms = <25>;
            key-positions = <14 15>;
            bindings = <&kp ESC>;
            layers = <BASE>;
        };

        combo_left_gui_shift {
            timeout-ms = <25>;
            key-positions = <10 13>;
            bindings = <&modifier_chord LGUI LSHFT>;
            slow-release;
            layers = <BASE>;
        };
        combo_left_gui_alt {
            timeout-ms = <25>;
            key-positions = <12 13>;
            bindings = <&modifier_chord LGUI LALT>;
            slow-release;
            layers = <BASE>;
        };
        combo_left_control_alt {
            timeout-ms = <25>;
            key-positions = <11 12>;
            bindings = <&modifier_chord LCTRL LALT>;
            slow-release;
            layers = <BASE>;
        };
        combo_left_shift_alt {
            timeout-ms = <25>;
            key-positions = <10 12>;
            bindings = <&modifier_chord LSHFT LALT>;
            slow-release;
            layers = <BASE>;
        };
        combo_left_shift_control {
            timeout-ms = <25>;
            key-positions = <10 11>;
            bindings = <&modifier_chord LSHFT LCTRL>;
            slow-release;
            layers = <BASE>;
        };

        combo_right_gui_shift {
            timeout-ms = <25>;
            key-positions = <16 19>;
            bindings = <&modifier_chord RGUI RSHFT>;
            slow-release;
            layers = <BASE>;
        };
        combo_right_gui_alt {
            timeout-ms = <25>;
            key-positions = <16 17>;
            bindings = <&modifier_chord RGUI RALT>;
            slow-release;
            layers = <BASE>;
        };
        combo_right_control_alt {
            timeout-ms = <25>;
            key-positions = <17 18>;
            bindings = <&modifier_chord RCTRL RALT>;
            slow-release;
            layers = <BASE>;
        };
        combo_right_alt_shift {
            timeout-ms = <25>;
            key-positions = <17 19>;
            bindings = <&modifier_chord RALT RSHFT>;
            slow-release;
            layers = <BASE>;
        };
        combo_right_control_shift {
            timeout-ms = <25>;
            key-positions = <18 19>;
            bindings = <&modifier_chord RCTRL RSHFT>;
            slow-release;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ── 0 · BASE: Colemak-DH with opposite-hand home-row mods ──────────
        base_layer {
            display-name = "Base";
            bindings = <
//  phys Q             W              E              R              T              Y         U              I              O              P
    &kp Q               &kp W          &kp F          &kp P          &kp B          &kp J     &kp L          &kp U          &kp Y          &kp SEMI
//  phys A                        S                         D                         F                         G       H       J                         K                         L                         ;
    &left_home_row_shift LSHFT A    &left_home_row_mod LCTRL R    &left_home_row_mod LALT S    &left_home_row_mod LGUI T    &kp G   &kp M   &right_home_row_mod RGUI N    &right_home_row_mod RALT E    &right_home_row_mod RCTRL I    &right_home_row_shift RSHFT O
//  phys Z    X    C    V    B    N    M    ,          .        /
    &kp Z     &kp X &kp C &kp D &kp V &kp K &apps_hold_tap APPS H &mm_comma &mm_dot &kp FSLH
//  thumbs· LO       LI                         RI                        RO
             &kp BSPC &thumb_layer_tap NAV SPACE &thumb_layer_tap NUMSYM RET &thumb_layer_tap FORWARD_DELETE TAB
            >;
        };

        // ── 1 · NUMSYM: hold RI from Base ──────────────────────────────────
        numsym_layer {
            display-name = "NumSym";
            bindings = <
//  phys Q    W    E    R    T    Y    U    I    O    P
    &kp N1   &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
//  phys A       S       D       F       G       H       J                         K                         L                           ;
    &kp LSHFT &kp LCTRL &kp LALT &kp LGUI &none   &none   &right_home_row_mod RGUI LPAR &right_home_row_mod RALT RPAR &right_home_row_mod RCTRL LBKT &right_home_row_mod RSHFT RBKT
//  phys Z    X          C           V                         B    N              M                    ,          .       /
    &none   &kp BSLH   &kp GRAVE   &mm_semicolon_colon &none &mm_plus_equals &mm_minus_underscore &mm_comma &mm_dot &kp FSLH
//  thumbs· LO       LI                  RI    RO
             &kp BSPC &numsym_space_tap &none &none
            >;
        };

        // ── 2 · NAV: hold LI from Base ─────────────────────────────────────
        nav_layer {
            display-name = "Navigation";
            bindings = <
//  phys Q                         W                E              R               T              Y       U    I    O    P
    &sl FKEYS &kp HYPER(RET) &kp MEH(LEFT) &kp MEH(RIGHT) &kp MEH(RET) &kp DEL &none &none &none &none
//  phys A                         S                                 D                               F                             G             H       J         K       L      ;
    &left_home_row_mod LSHFT LG(LBKT) &left_home_row_mod LCTRL LG(RBKT) &left_home_row_mod LALT LG(LS(LBKT)) &left_home_row_mod LGUI LG(LS(RBKT)) &kp LG(GRAVE) &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp ESC
//  phys Z              X             C             V             B             N        M             ,             .      /
    &kp LC(F3)           &kp LC(F4)    &kp C_BRI_DN  &kp C_BRI_UP  &caps_word    &kp C_PP &kp C_VOL_DN &kp C_VOL_UP &none  &none
//  thumbs· LO    LI    RI                                        RO
             &none &none &navigation_thumb_tap LALT LS(RET) &navigation_thumb_tap LSHFT BSPC
            >;
        };

        // ── 3 · APPS: hold physical M, then use one key ────────────────────
        apps_layer {
            display-name = "Apps";
            bindings = <
//  phys Q         W         E         R         T         Y         U         I         O         P
    &kp MEH(Q)     &kp MEH(W) &kp MEH(F) &kp MEH(P) &kp MEH(B) &kp MEH(J) &kp MEH(L) &kp MEH(U) &kp MEH(Y) &none
//  phys A         S         D         F         G         H         J         K         L         ;
    &kp MEH(A)     &kp MEH(R) &kp MEH(S) &kp MEH(T) &kp MEH(G) &kp MEH(M) &kp MEH(N) &kp MEH(E) &kp MEH(I) &kp MEH(O)
//  phys Z         X         C         V         B         N         M         ,      .      /
    &kp MEH(Z)     &kp MEH(X) &kp MEH(C) &kp MEH(D) &kp MEH(V) &kp MEH(K) &kp MEH(H) &none  &none  &none
//  thumbs· LO       LI       RI      RO
             &kp LC(F5) &kp LC(F6) &kp LGUI &none
            >;
        };

        // ── 4 · FKEYS: Q from Navigation; F-key actions return to Base ────
        fkeys_layer {
            display-name = "FKeys";
            bindings = <
//  phys Q          W          E          R          T          Y          U          I          O          P
    &fkey_action F1 &fkey_action F2 &fkey_action F3 &fkey_action F4 &fkey_action F5 &fkey_action F6 &fkey_action F7 &fkey_action F8 &fkey_action F9 &fkey_action F10
//  phys A                   S                   D                   F                   G              H              J                   K                  L                  ;
    &fkeys_modifier LSHFT    &fkeys_modifier LCTRL &fkeys_modifier LALT &fkeys_modifier LGUI &fkey_action F11 &fkey_action F12 &fkeys_modifier RGUI &fkeys_modifier RALT &fkeys_modifier RCTRL &fkeys_modifier RSHFT
//  phys Z          X          C          V          B          N          M          ,          .          /
    &fkeys_rearm   &fkeys_rearm &fkeys_rearm &fkeys_rearm &fkeys_rearm &fkeys_rearm &fkeys_rearm &fkeys_rearm &fkeys_rearm &fkeys_rearm
//  thumbs· LO       LI       RI       RO
             &fkeys_rearm &fkeys_rearm &fkeys_rearm &fkeys_rearm
            >;
        };

        // ── 5 · FORWARD DELETE: hold RO, then tap LI ───────────────────────
        forward_delete_layer {
            display-name = "Forward Delete";
            bindings = <
//  phys Q    W      E      R      T      Y      U      I      O      P
    &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
//  phys A    S      D      F      G      H      J      K      L      ;
    &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
//  phys Z    X      C      V      B      N      M      ,      .      /
    &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
//  thumbs· LO    LI       RI     RO
             &trans &kp DEL &trans &trans
            >;
        };
    };
};
